# Evita que tus contenedores/redes/volúmenes choquen de nombre con otros
# proyectos en el mismo VPS compartido
COMPOSE_PROJECT_NAME=proyecto1

SECRET_KEY=
DEBUG=False
DB_NAME=brisas_pacande
DB_USER=postgres
DB_PASSWORD=
DB_HOST=db
DB_PORT=5432
ALLOWED_HOSTS=IP_DEL_VPS,brisasdepacande.app,www.brisasdepacande.app
CSRF_TRUSTED_ORIGINS=https://brisasdepacande.app,https://www.brisasdepacande.app

# Poner en True solo cuando el nginx del VPS ya sirva este dominio por HTTPS
# (lo gestiona el administrador con Certbot a nivel de host)
USE_HTTPS=False
